# ============================================================
# run_all_tranches.mac
#
# Exécute séquentiellement les 10 tranches.
# Chaque tranche définit ses paramètres puis appelle tranche.mac
# ============================================================

# ==================== CONFIGURATION GENERALE ====================

/run/numberOfThreads 10
/random/setSeeds 16092026 8213

/mcp/setPlateDiameter 0.5 mm
/mcp/setThickness 1 mm
/mcp/setChannelDiameter 15 um
/mcp/setChannelAngle 8 deg
/mcp/setVoltage 1000 V

/mcp/setMaxTracksPerEvent 1000000
/mcp/setMaxGenerations 0
/mcp/setTransitOutput false

/run/initialize

# Les valeurs de muZ ci-dessous sont dans le repere de la simulation amont :
# zOrigin est la position de la face d'entree de la plaque dans ce repere.
# Sans cette ligne, muZ ~ 9.5 mm sort de la plaque de 1 mm et
# PrimaryGeneratorAction leve une exception fatale des le premier beamOn.
/source/gauss/zOrigin 9.5 mm

# Injections par tranche. A 100, il ne reste que 2 a 11 evenements exploitables
# pour les temps (seuil de 20 dans analysis/scan_tranches.C) : la plupart des
# primaires de 277 keV traversent sans multiplier. Le balayage complet coute
# environ 2 s pour 100 injections, donc la statistique est peu chere.
/control/alias nEvents 5000

# ==================== TRANCHE 0 ====================
/control/alias tranche 0
/control/alias muE 269.961
/control/alias sigmaE 138.426
/control/alias muZ 9.55733
/control/alias sigmaZ 0.0262282
/control/alias muPz 177.129
/control/alias sigmaPz 318.022

/control/execute macros/tranche.mac


# ==================== TRANCHE 1 ====================
/control/alias tranche 1
/control/alias muE 277.279
/control/alias sigmaE 134.599
/control/alias muZ 9.65046
/control/alias sigmaZ 0.0288612
/control/alias muPz 178.119
/control/alias sigmaPz 313.170

/control/execute macros/tranche.mac


