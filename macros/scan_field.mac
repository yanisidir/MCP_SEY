# Balayage de la longueur du canal A CHAMP CONSTANT, 1 kV/mm.
# Depuis la racine du projet : ./build/MCP_SEY macros/scan_field.mac
# Puis : root -l -b -q 'analysis/scan_thickness.C("root_files/scanField_*.root","figures/scan_field")'
#
# A champ constant l'energie acquise entre deux collisions ne change pas, mais
# le nombre de collisions croit proportionnellement a L : le gain croit donc
# EXPONENTIELLEMENT avec la longueur, sans optimum. Extrapolation depuis le
# point a 1 mm (gain ~ 4e2) : ~9e3 a 1.5 mm, ~2e5 a 2 mm, ~4e6 a 2.5 mm,
# ~9e7 a 3 mm. Le plafond de tracks mord donc a partir de 2.5 mm et le gain y
# est minore ; la colonne limites(%) de l'analyse le signale.
#
# setPlateDiameter doit verifier plateDiameter/2 > L*tan(angle) + D/(2cos),
# soit 0.86 mm a L = 3 mm et 8 degres.
/run/numberOfThreads 10
/random/setSeeds 24092026 1117
/mcp/setPlateDiameter 2 mm
/mcp/setThickness 1 mm
/mcp/setChannelDiameter 15 um
/mcp/setChannelAngle 8 deg
/mcp/setVoltage 1000 V
/mcp/setMaxTracksPerEvent 10000000
/mcp/setMaxGenerations 0
/mcp/setTransitOutput false
/mcp/setWuModel true
/run/initialize
# Source : sigma nuls = tir fixe. muPz au-dela de p : tir axial +z.
/source/gauss/muE 300 eV
/source/gauss/sigmaE 0 eV
/source/gauss/muZ 0 mm
/source/gauss/sigmaZ 0 mm
/source/gauss/muPz 1 MeV
/source/gauss/sigmaPz 0 keV
/run/printProgress 50

# Injections par point. Les longs canaux coutent cher : voir les durees dans
# l'en-tete. Baisser cette valeur pour un balayage exploratoire.
/control/alias nEvents 100

# ==================== L = 1.0 mm ====================
/control/alias Thickness 1
/control/alias Voltage 1000
/control/execute macros/scan_field_point.mac

# ==================== L = 1.5 mm ====================
/control/alias Thickness 1.5
/control/alias Voltage 1500
/control/execute macros/scan_field_point.mac

# ==================== L = 2.0 mm ====================
/control/alias Thickness 2
/control/alias Voltage 2000
/control/execute macros/scan_field_point.mac

# ==================== L = 2.5 mm ====================
/control/alias Thickness 2.5
/control/alias Voltage 2500
/control/execute macros/scan_field_point.mac

# ==================== L = 3.0 mm ====================
/control/alias Thickness 3
/control/alias Voltage 3000
/control/execute macros/scan_field_point.mac
