# Balayage de reference sur la geometrie de Wu et al., Rev. Sci. Instrum. 79
# (2008) 073104 : 10 um de diametre, 0.46 mm d'epaisseur, biais 8 degres.
#
# C'est la seule reference publiee dont toutes les conditions coincident avec
# les notres : meme angle de biais, canal droit, regime impulsionnel, pas de
# charge d'espace dans le modele, gain defini comme sortie/entree zeros inclus,
# et flux experimental explicitement limite a moins de 1 quantum/microcanal/s
# pour eviter toute saturation.
#
# La plage 450-950 V par pas de 50 V est exactement celle de sa figure 3, pour
# comparer point par point plutot que par une pente tiree de deux mesures.
# Reference : k mesure = 0.0134 /V, k de sa propre simulation = 0.0126 /V.
#
# Depuis la racine : ./build/MCP_SEY macros/scan_wu.mac
# Puis : root -l -b -q 'analysis/gain_voltage.C("root_files/scanWu_*.root","figures/gain_voltage_wu")'
/run/numberOfThreads 10
/random/setSeeds 29092026 8108
/mcp/setPlateDiameter 0.5 mm
/mcp/setThickness 0.46 mm
/mcp/setChannelDiameter 10 um
/mcp/setChannelAngle 8 deg
/mcp/setVoltage 450 V
/mcp/setMaxTracksPerEvent 1000000
/mcp/setMaxGenerations 0
/mcp/setTransitOutput false
/run/initialize
# Source : sigma nuls = tir fixe. muPz au-dela de p : tir axial +z.
/source/gauss/muE 300 eV
/source/gauss/sigmaE 0 eV
/source/gauss/muZ 0 mm
/source/gauss/sigmaZ 0 mm
/source/gauss/muPz 1 MeV
/source/gauss/sigmaPz 0 keV
/run/printProgress 100

/control/alias nEvents 500
/control/foreach macros/scan_wu_point.mac voltage "450 500 550 600 650 700 750 800 850 900 950"
