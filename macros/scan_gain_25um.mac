# Balayage en tension pour un canal de 25 um de diametre et 3 mm de long.
# Depuis la racine du projet : ./build/MCP_SEY macros/scan_gain_25um.mac
# Puis : root -l -b -q 'analysis/gain_voltage.C("root_files/scanV25_*.root","figures/gain_voltage_25um")'
#
# plateDiameter doit verifier plateDiameter/2 > L*tan(angle) + D/(2cos),
# soit 0.868 mm ici ; on prend 2 mm.
/run/numberOfThreads 10
/random/setSeeds 24092026 3125
/mcp/setPlateDiameter 2 mm
/mcp/setThickness 3 mm
/mcp/setChannelDiameter 25 um
/mcp/setChannelAngle 8 deg
/mcp/setVoltage 1200 V
/mcp/setMaxTracksPerEvent 1000000
/mcp/setMaxGenerations 0
/mcp/setTransitOutput false
/mcp/setWuModel true
/run/initialize
# Source : sigma nuls = tir fixe. muPz au-dela de p : tir axial +z.
/source/gauss/muE 300 eV
/source/gauss/sigmaE 0 eV
/source/gauss/muZ 0 mm
/source/gauss/sigmaZ 0 mm
/source/gauss/muPz 1 MeV
/source/gauss/sigmaPz 0 keV
/run/printProgress 100

# Le TTS, estime par croisement direct a mi-hauteur, exige au moins 50 avalanches
# exploitables par point, et 500 pour une barre d'erreur serree.

/control/alias nEvents 500
/control/foreach macros/scan_gain_25um_point.mac voltage "1200 1300 1400 1500 1600 1700 1800 1900"

# Dernier point : statistique reduite, le cout y est domine par le gain.
/control/alias nEvents 150
/control/foreach macros/scan_gain_25um_point.mac voltage "2000"
